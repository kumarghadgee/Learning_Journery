public class Program1 {
//	Scanner sc = new Scanner(System.in);
	public static void main(String[] args) {
		int[] arr = { 1, 2, 3, 4, 5 , 6, 7, 8 };
		int i = 0;
		int Even =0;
		int Odd = 0;
		while(i < arr.length - 1) {
			if(arr[i] % 2 == 0) {
				Even++;
			}
			else {
				Odd++;
			}
			i++;
		}
		
		System.out.println("Even : "+ Even);
		System.out.println("Odd : "+ Odd);
	}
}
