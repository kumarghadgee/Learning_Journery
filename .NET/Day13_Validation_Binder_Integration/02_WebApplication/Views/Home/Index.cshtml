@model List<_02_WebApplication.Models.Emp>
@{
    Layout = "CommonMaster";
}
<html>
<head>
    <title>Home</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
</head>

<body>
    <div class="container mt-2">
        <a href="/Home/Create" class="btn btn-primary">Add New Employee</a>
        <hr />
        <h1>Employee List</h1>
        <div class="table-responsive">
            <table class="table table-bordered text-center">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>Name</th>
                        <th>Address</th>
                        <th>Edit</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td>@emp.No</td>
                            <td>@emp.Name</td>
                            <td>@emp.Address</td>
                            <td>
                                <a href="/Home/Edit/@emp.No" class="btn btn-warning">Edit</a>
                            </td>
                            <td>
                                <a href=" /Home/Delete/@emp.No" class="btn btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

        
</body>
</html>
