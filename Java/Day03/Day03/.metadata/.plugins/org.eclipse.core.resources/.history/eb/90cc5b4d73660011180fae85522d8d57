package com.sunbeam;

class Students{
	int age;
	String name;
	double percentage;
	
	void Display() {
		System.out.println(name);
		System.out.println(age);
		System.out.println(percentage);
	}
}


public class Program2 {
	public static void main(String[] args) {
		Students s = new Students();
	    s.name = "Kumar";
	    s.age = 22;
	    s.percentage = 88.16;
	    s.Display();
	    
	    Students s1 = new Students();
	    s1.name = "Gaurav";
	    s1.age = 23;
	    
	    s1.Display();
	    s1.percentage = 87.80;
	}
}
