package com.sunbeam;


import static org.junit.jupiter.api.Assertions.assertEquals;

import java.time.Duration;

import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.chrome.ChromeOptions;

public class Selenium_JUint {
	private WebDriver driver;
	
	@BeforeEach
	void setupTest() {
	    ChromeOptions options = new ChromeOptions();
		options.addArguments("--headless");
		driver = new ChromeDriver(options);
		driver.manage().timeouts().implicitlyWait(Duration.ofMillis(20000));		

		String url = "https://nilesh-g.github.io/learn-web/JS/demo16.html";
		driver.get(url);
	}
	
	@AfterEach
	void teardown() {
		driver.quit();
	}
	
	@Test
	void testEnquiryFormPositive() {
		WebElement nameElem = driver.findElement(By.id("nameInput"));
		nameElem.sendKeys("Kumargaurav Ghadge");
		
		WebElement emailElem = driver.findElement(By.id("emailInput"));
		emailElem.sendKeys("kumar01@gamil.com");
		
		WebElement mobileElem = driver.findElement(By.id("mobileInput"));
		mobileElem.sendKeys("9987654321");
		
		WebElement queryElem = driver.findElement(By.id("queryInput"));
		queryElem.sendKeys("What is the placement stats of CP-AC Course");
		
		WebElement submitElem = driver.findElement(By.cssSelector("input[type='submit']"));
		submitElem.click();
		
		WebElement msgElem = driver.findElement(By.id("msg"));
		String actual = msgElem.getText();
		String expected = "Form Submitted";
		assertEquals(expected,actual);
	}
	
	@Test
	void testEnquiryFormNegative() {
		WebElement nameElem = driver.findElement(By.id("nameInput"));
		nameElem.sendKeys("Kumargaurav Ghadge");
		
		WebElement emailElem = driver.findElement(By.id("emailInput"));
		emailElem.sendKeys("kumar01@gmail.com");
		
		WebElement mobileElem = driver.findElement(By.id("mobileInput"));
		mobileElem.sendKeys("9887654321");
		
		WebElement queryElem = driver.findElement(By.id("queryInput"));
		queryElem.sendKeys("What is the Placement stats of CP-AC Course");
		
		WebElement submitElem = driver.findElement(By.id("input[type='submit']"));
		submitElem.click();
		
		WebElement msgElem = driver.findElement(By.id("msg"));
		String actual = msgElem.getText();
		String expected = "Validation Error";
		assertEquals(expected,actual);
	}
}

























